generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  FINANCE
  OPERATIONS
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST
  EXPENSE
}

enum EntrySource {
  INVOICE
  BANK_RECEIPT
  CONTRACT_PAYMENT
  RENTAL_CHARGE
  RENTAL_PAYMENT
  MEASUREMENT
  MANUAL
}

enum PayableStatus {
  OPEN
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  EXPORTED
  ISSUED
  CANCELLED
}

enum StockMovementType {
  ENTRY
  EXIT
}

enum FinancialTitleKind {
  BOLETO
  DUPLICATE
  PROMISSORY_NOTE
  OTHER
}

enum RentalDocumentKind {
  NFSE
  INVOICE
  RENTAL_RECEIPT
  OTHER
}

model Company {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  taxIdEncrypted String
  createdAt      DateTime         @default(now())
  users          User[]
  accounts       Account[]
  projects       Project[]
  partners       Partner[]
  contracts      LaborContract[]
  entries        JournalEntry[]
  invoices       ServiceInvoice[]
  receivables    Receivable[]
  payables       Payable[]
  bankStatements BankStatement[]
  idempotency    IdempotencyKey[]
  taxBrackets    TaxBracket[]
  monthlyTasks   MonthlyTask[]
  goodsSales     GoodsSale[]
  inventoryProducts InventoryProduct[]
  stockMovements StockMovement[]
  reportTemplates ReportTemplate[]
  financialTitles FinancialTitle[]
  equipmentRentals EquipmentRental[]
  rentalCharges RentalCharge[]
  rentalChargeFiles RentalChargeFile[]
  mailConnection MailConnection?
  mailMessages MailMessage[]
  mailAttachments MailAttachment[]
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  entries      JournalEntry[]
  stockMovements StockMovement[]
  preferences  UserPreference?
}

model UserPreference {
  userId            String   @id @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String   @default("dark") @db.VarChar(5)
  locale            String   @default("pt-BR") @db.VarChar(5)
  decimalPlaces     Int      @default(2)
  loadedScreenLimit Int      @default(8)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshHash      String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  operation   String
  requestHash String
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([companyId, operation, key])
  @@index([expiresAt])
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  code         String
  name         String
  type         AccountType
  active       Boolean       @default(true)
  debitEntries JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")

  @@unique([companyId, code])
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id])
  code        String
  name        String
  active      Boolean         @default(true)
  contracts   LaborContract[]
  entries     JournalEntry[]
  invoices    ServiceInvoice[]
  receivables Receivable[]
  payables    Payable[]
  stockMovements StockMovement[]
  equipmentRentals EquipmentRental[]

  @@unique([companyId, code])
  @@unique([companyId, id])
}

model Partner {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id])
  name            String
  taxIdEncrypted  String?
  bankEncrypted   String?
  customer        Boolean          @default(false)
  supplier        Boolean          @default(false)
  invoices        ServiceInvoice[]
  contracts       LaborContract[]
  receivables     Receivable[]
  payables        Payable[]
  equipmentRentals EquipmentRental[]

  @@unique([companyId, id])
}

model LaborContract {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id])
  projectId        String        @db.Uuid
  project          Project       @relation(fields: [projectId], references: [id])
  contractorId     String        @db.Uuid
  contractor       Partner       @relation(fields: [contractorId], references: [id])
  number           String
  description      String
  amount           Decimal       @db.Decimal(18, 2)
  issWithheld      Boolean       @default(false)
  inssWithheld     Boolean       @default(false)
  issAmount        Decimal       @default(0) @db.Decimal(18, 2)
  inssAmount       Decimal       @default(0) @db.Decimal(18, 2)
  signedAt         DateTime?
  measurements     Measurement[]
  payables         Payable[]

  @@unique([companyId, number])
}

model Measurement {
  id         String        @id @default(uuid()) @db.Uuid
  contractId String        @db.Uuid
  contract   LaborContract @relation(fields: [contractId], references: [id])
  amount     Decimal       @db.Decimal(18, 2)
  issAmount  Decimal       @default(0) @db.Decimal(18, 2)
  inssAmount Decimal       @default(0) @db.Decimal(18, 2)
  measuredAt DateTime
  approvedAt DateTime?
  payable    Payable?
}

model JournalEntry {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @db.Uuid
  company         Company        @relation(fields: [companyId], references: [id])
  debitAccountId  String         @db.Uuid
  debitAccount    Account        @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String         @db.Uuid
  creditAccount   Account        @relation("CreditAccount", fields: [creditAccountId], references: [id])
  projectId       String?        @db.Uuid
  project         Project?       @relation(fields: [projectId], references: [id])
  amount          Decimal        @db.Decimal(18, 2)
  description     String
  source          EntrySource
  sourceId        String         @db.Uuid
  occurredAt      DateTime
  createdById     String         @db.Uuid
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([companyId, occurredAt])
  @@index([companyId, projectId])
  @@unique([companyId, source, sourceId, debitAccountId, creditAccountId])
}

model ServiceInvoice {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  projectId      String        @db.Uuid
  project        Project       @relation(fields: [projectId], references: [id])
  customerId     String        @db.Uuid
  customer       Partner       @relation(fields: [customerId], references: [id])
  number         String
  amount         Decimal       @db.Decimal(18, 2)
  serviceDate    DateTime
  taxAnnex       String
  issWithheld    Boolean       @default(false)
  inssWithheld   Boolean       @default(false)
  issAmount      Decimal       @default(0) @db.Decimal(18, 2)
  inssAmount     Decimal       @default(0) @db.Decimal(18, 2)
  status         InvoiceStatus @default(DRAFT)
  layoutVersion  String?
  xmlEncrypted   String?
  receivable     Receivable?

  @@unique([companyId, number])
}

model GoodsSale {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  number    String
  amount    Decimal  @db.Decimal(18, 2)
  soldAt    DateTime
  cancelled Boolean  @default(false)

  @@unique([companyId, number])
}

model Receivable {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  company     Company        @relation(fields: [companyId], references: [id])
  invoiceId   String         @unique @db.Uuid
  invoice     ServiceInvoice @relation(fields: [invoiceId], references: [id])
  customerId  String         @db.Uuid
  customer    Partner        @relation(fields: [customerId], references: [id])
  projectId   String         @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id])
  amount      Decimal        @db.Decimal(18, 2)
  received    Decimal        @default(0) @db.Decimal(18, 2)
  dueAt       DateTime
  bankMatches BankTransaction[]
  financialTitle FinancialTitle?

  @@unique([companyId, id])
}

model Payable {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  contractorId String        @db.Uuid
  contractor   Partner       @relation(fields: [contractorId], references: [id])
  contractId   String?       @db.Uuid
  contract     LaborContract? @relation(fields: [contractId], references: [id])
  rentalChargeId String?     @db.Uuid
  rentalCharge RentalCharge? @relation(fields: [companyId, rentalChargeId], references: [companyId, id], onDelete: Restrict)
  measurementId String?       @unique @db.Uuid
  measurement   Measurement?  @relation(fields: [measurementId], references: [id])
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id])
  amount       Decimal       @db.Decimal(18, 2)
  dueAt        DateTime
  status       PayableStatus @default(OPEN)
  paidAt       DateTime?
  financialTitle FinancialTitle?

  @@unique([companyId, id])
  @@unique([companyId, rentalChargeId])
}

model EquipmentRental {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectId           String   @db.Uuid
  project             Project  @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  supplierId          String   @db.Uuid
  supplier            Partner  @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  number              String   @db.VarChar(80)
  equipmentName       String   @db.VarChar(160)
  equipmentIdentifier String   @default("") @db.VarChar(120)
  quantity            Int
  startsAt            DateTime @db.Date
  expectedReturnAt    DateTime? @db.Date
  returnedAt          DateTime? @db.Date
  notes               String   @default("") @db.VarChar(2000)
  revision            Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  charges             RentalCharge[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, projectId, startsAt])
}

model RentalCharge {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rentalId       String             @db.Uuid
  rental         EquipmentRental    @relation(fields: [companyId, rentalId], references: [companyId, id], onDelete: Restrict)
  documentKind   RentalDocumentKind
  documentNumber String             @db.VarChar(80)
  issuedAt       DateTime           @db.Date
  dueAt          DateTime           @db.Date
  amount         Decimal            @db.Decimal(18, 2)
  documentUrl    String             @default("") @db.VarChar(2000)
  notes          String             @default("") @db.VarChar(2000)
  createdAt      DateTime           @default(now())
  payable        Payable?
  files          RentalChargeFile[]
  mailAttachments MailAttachment[]

  @@unique([companyId, id])
  @@unique([companyId, rentalId, documentKind, documentNumber])
  @@index([companyId, rentalId, issuedAt])
}

model RentalChargeFile {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rentalChargeId   String       @db.Uuid
  rentalCharge     RentalCharge @relation(fields: [companyId, rentalChargeId], references: [companyId, id], onDelete: Restrict)
  fileName         String       @db.VarChar(180)
  mediaType        String       @db.VarChar(80)
  sizeBytes        Int
  contentEncrypted String
  createdAt        DateTime     @default(now())

  @@index([companyId, rentalChargeId])
}

model MailConnection {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @unique @db.Uuid
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  username          String    @db.VarChar(254)
  passwordEncrypted String
  folder            String    @default("INBOX") @db.VarChar(200)
  enabled           Boolean   @default(true)
  autoSync          Boolean   @default(false)
  importSince       DateTime  @db.Date
  revision          Int       @default(1)
  mailboxVersion    String    @default(uuid()) @db.Uuid
  uidValidity       String?   @db.VarChar(40)
  cursorUid         BigInt    @default(0)
  syncToken         String?   @db.Uuid
  syncUntil         DateTime?
  lastSyncedAt      DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncError     String?   @db.VarChar(300)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled, autoSync, lastSyncAttemptAt])
}

model MailMessage {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  mailboxVersion    String    @db.Uuid
  uidValidity       String    @db.VarChar(40)
  uid               BigInt
  messageId         String?   @db.VarChar(500)
  subject           String    @db.VarChar(500)
  from              String    @db.VarChar(1000)
  receivedAt        DateTime
  bodyTextEncrypted String
  warnings          Json
  createdAt         DateTime  @default(now())
  attachments       MailAttachment[]

  @@unique([companyId, id])
  @@unique([companyId, mailboxVersion, uidValidity, uid])
  @@index([companyId, receivedAt, id])
}

model MailAttachment {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @db.Uuid
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  messageId         String       @db.Uuid
  message           MailMessage  @relation(fields: [companyId, messageId], references: [companyId, id], onDelete: Restrict)
  partId            String       @db.VarChar(80)
  fileName          String       @db.VarChar(180)
  mediaType         String       @db.VarChar(80)
  sizeBytes         Int
  contentHash       String       @db.VarChar(64)
  contentEncrypted  String
  rentalChargeId    String?      @db.Uuid
  rentalCharge      RentalCharge? @relation(fields: [companyId, rentalChargeId], references: [companyId, id], onDelete: Restrict)
  importedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@unique([companyId, messageId, partId])
  @@unique([companyId, messageId, contentHash])
  @@index([companyId, rentalChargeId])
}

model FinancialTitle {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payableId    String?            @db.Uuid
  payable      Payable?           @relation(fields: [companyId, payableId], references: [companyId, id], onDelete: Restrict)
  receivableId String?            @db.Uuid
  receivable   Receivable?        @relation(fields: [companyId, receivableId], references: [companyId, id], onDelete: Restrict)
  kind         FinancialTitleKind @default(BOLETO)
  number       String             @db.VarChar(80)
  bankName     String             @default("") @db.VarChar(120)
  digitLine    String             @default("") @db.VarChar(48)
  barcode      String             @default("") @db.VarChar(44)
  notes        String             @default("") @db.VarChar(2000)
  revision     Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([companyId, payableId])
  @@unique([companyId, receivableId])
  @@index([companyId, updatedAt])
}

model BankStatement {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  company      Company           @relation(fields: [companyId], references: [id])
  fileHash     String
  importedAt   DateTime          @default(now())
  transactions BankTransaction[]

  @@unique([companyId, fileHash])
}

model BankTransaction {
  id            String        @id @default(uuid()) @db.Uuid
  statementId   String        @db.Uuid
  statement     BankStatement @relation(fields: [statementId], references: [id])
  externalId    String
  amount        Decimal       @db.Decimal(18, 2)
  postedAt      DateTime
  description   String
  receivableId  String?       @db.Uuid
  receivable    Receivable?   @relation(fields: [receivableId], references: [id])
  reconciledAt  DateTime?

  @@unique([statementId, externalId])
}

model TaxBracket {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  annex          String
  lowerLimit     Decimal  @db.Decimal(18, 2)
  upperLimit     Decimal  @db.Decimal(18, 2)
  nominalRate    Decimal  @db.Decimal(8, 6)
  deduction      Decimal  @db.Decimal(18, 2)
  effectiveFrom  DateTime
  effectiveUntil DateTime?

  @@index([companyId, annex, effectiveFrom])
}

model MonthlyTask {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  month       DateTime @db.Date
  title       String
  completedAt DateTime?

  @@unique([companyId, month, title])
}

model InventoryProduct {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @db.Uuid
  company         Company         @relation(fields: [companyId], references: [id])
  sku             String
  name            String
  unit            String
  minimumQuantity Decimal         @default(0) @db.Decimal(18, 3)
  quantity        Decimal         @default(0) @db.Decimal(18, 3)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  movements       StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, name])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  company     Company           @relation(fields: [companyId], references: [id])
  productId   String            @db.Uuid
  product     InventoryProduct  @relation(fields: [productId], references: [id])
  projectId   String?           @db.Uuid
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 3)
  reason      String
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, productId])
}

model ReportTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  definition  Json
  revision    Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, active, updatedAt])
}
